# Copy to .env and fill in. Only the providers you actually run are required.
# .env is gitignored — never commit real keys.

# OpenAI (gpt-* configs)
OPENAI_API_KEY=

# Anthropic (claude-* configs)
ANTHROPIC_API_KEY=

# Google (gemini-* configs)
GOOGLE_API_KEY=

# Academic AI gateway (academic-ai-* configs, see academic_ai.py)
ACADEMIC_AI_ID=
ACADEMIC_AI_SECRET=

# Locally served models (Qwen, Llama, Olmo) need no key — run_agent.py talks to
# a vLLM OpenAI-compatible endpoint on the `port` given in the config.
